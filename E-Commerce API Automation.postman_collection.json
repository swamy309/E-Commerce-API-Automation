        {
          "name": "TC_004_Get_Users_Pagination",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code should be 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Only 5 users should be returned\", function () {\r\n    pm.expect(data.users.length).to.eql(5);\r\n});\r\n\r\npm.test(\"Total users count should be available\", function () {\r\n    pm.expect(data.total).to.be.above(0);\r\n});\r\n\r\npm.test(\"Limit should be 5\", function () {\r\n    pm.expect(data.limit).to.eql(5);\r\n});\r\n\r\npm.test(\"Skip should be 5\", function () {\r\n    pm.expect(data.skip).to.eql(5);\r\n});\r\npm.test(\"Second page should return different users\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.users[0].id).to.not.eql(1);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?limit=5&skip=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "skip",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
