        {
          "name": "TC_002_Create_User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Status code should be 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"User ID should be present\", function () {\r",
                  "    pm.expect(jsonData.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"First name should be Swamy\", function () {\r",
                  "    pm.expect(jsonData.firstName).to.eql(\"Swamy\");\r",
                  "});\r",
                  "\r",
                  "// Capture dynamic user ID\r",
                  "pm.environment.set(\"userId\", jsonData.id);\r",
                  "\r",
                  "pm.test(\"User ID saved in environment\", function () {\r",
                  "    pm.expect(pm.environment.get(\"userId\")).to.eql(jsonData.id);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNumber = Math.floor(Math.random() * 100000);\r",
                  "\r",
                  "pm.environment.set(\r",
                  "    \"randomEmail\",\r",
                  "    \"swamy\" + randomNumber + \"@test.com\"\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstName\": \"Swamy\",\r\n  \"lastName\": \"Dandu\",\r\n  \"age\": 34,\r\n  \"email\": \"{{randomEmail}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
