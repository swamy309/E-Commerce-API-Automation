        {
          "name": "TC_001_Get_All_Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "// Test Case 1: Verify Status Code\r",
                  "pm.test(\"Status code should be 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Test Case 2: Verify Response Time\r",
                  "pm.test(\"Response time should be below 3000ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
                  "});\r",
                  "\r",
                  "// Test Case 3: Verify Response Body\r",
                  "pm.test(\"Response body should not be empty\", function () {\r",
                  "    pm.expect(pm.response.text()).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "// Test Case 4: Verify Users Array\r",
                  "pm.test(\"Users array should exist\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.users).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// Test Case 5: Verify Users Count\r",
                  "pm.test(\"Users list should contain records\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.users.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "// Test Case 6: Verify First User ID\r",
                  "pm.test(\"First user should have a valid ID\", function () {\r",
                  "    let jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.users[0].id).to.be.a(\"number\");\r",
                  "});\r",
                  "const data = pm.response.json();\r",
                  "\r",
                  "pm.environment.set(\"existingUserId\", data.users[0].id);\r",
                  "\r",
                  "console.log(\"Saved User ID:\", data.users[0].id);\r",
                  "const schema = {\r",
                  "    type: \"object\",\r",
                  "    required: [\"users\", \"total\", \"skip\", \"limit\"],\r",
                  "    properties: {\r",
                  "        users: {\r",
                  "            type: \"array\",\r",
                  "            items: {\r",
                  "                type: \"object\",\r",
                  "                required: [\"id\", \"firstName\", \"lastName\", \"email\"],\r",
                  "                properties: {\r",
                  "                    id: { type: \"number\" },\r",
                  "                    firstName: { type: \"string\" },\r",
                  "                    lastName: { type: \"string\" },\r",
                  "                    email: { type: \"string\" }\r",
                  "                }\r",
                  "            }\r",
                  "        },\r",
                  "        total: { type: \"number\" },\r",
                  "        skip: { type: \"number\" },\r",
                  "        limit: { type: \"number\" }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "pm.test(\"Response should match JSON schema\", function () {\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
                  "});"
                ],
                "packages": {},
                "requests": {},
                "type": "text/javascript"
              }
            }
