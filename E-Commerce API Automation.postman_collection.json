                "exec": [
                  "pm.test(\"Status code should be 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"User ID should match saved ID\", function () {\r\n    pm.expect(data.id).to.eql(\r\n        Number(pm.environment.get(\"existingUserId\"))\r\n    );\r\n});\r\n\r\npm.test(\"Email should be available\", function () {\r\n    pm.expect(data.email).to.include(\"@\");\r\n});"
                ]
              }
            }
